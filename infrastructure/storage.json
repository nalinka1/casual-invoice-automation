{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private invoice storage and on-demand ledger; no scheduled execution in this foundation stack",
  "Resources": {
    "PrivateBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "VersioningConfiguration": {"Status": "Enabled"}
      }
    },
    "PrivateBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "PrivateBucket"},
        "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "RequireTLS", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{"Fn::GetAtt": ["PrivateBucket", "Arn"]}, {"Fn::Sub": "${PrivateBucket.Arn}/*"}], "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}
      }
    },
    "Ledger": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{"AttributeName": "pk", "AttributeType": "S"}],
        "KeySchema": [{"AttributeName": "pk", "KeyType": "HASH"}],
        "SSESpecification": {"SSEEnabled": true}
      }
    },
    "GmailSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {"Description": "Gmail OAuth credentials; populated privately after deployment"}
    }
  },
  "Outputs": {
    "BucketName": {"Value": {"Ref": "PrivateBucket"}},
    "LedgerTableName": {"Value": {"Ref": "Ledger"}},
    "GmailSecretArn": {"Value": {"Ref": "GmailSecret"}}
  }
}
